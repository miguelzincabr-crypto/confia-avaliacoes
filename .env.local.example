# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# Se deixado em branco, a aplicação roda automaticamente em MODO DEMO
# (dados locais no navegador, sem necessidade de backend).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: usado apenas no servidor para operações administrativas (RLS bypass).
# Nunca exponha a SERVICE_ROLE_KEY no frontend.
SUPABASE_SERVICE_ROLE_KEY=
